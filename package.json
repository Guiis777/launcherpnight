{
  "name": "pokenight-launcher",
  "version": "1.0.0",
  "description": "PokeNight Game Launcher",
  "main": "main.js",
  "author": "PokeNight",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "admin": "electron admin-main.js",
    "build": "electron-builder --win --x64",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.pokenight.launcher",
    "productName": "PokeNight Launcher",
    "win": {
      "target": "nsis",
      "icon": "assets/tamer_quest_icon.ico",
      "sign": null,
      "signingHashAlgorithms": null
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "installerIcon": "assets/tamer_quest_icon.ico",
      "shortcutName": "PokeNight Launcher"
    },
    "files": [
      "**/*",
      "!dist/**",
      "!server/**",
      "!.git/**"
    ],
    "extraResources": [],
    "asar": false
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "axios": "^1.13.5",
    "basic-ftp": "^5.1.0",
    "fs-extra": "^11.3.3",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  }
}
