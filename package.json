{
  "name": "pokenight-launcher",
  "version": "1.0.0",
  "description": "PokeNight Game Launcher",
  "main": "main.js",
  "author": "PokeNight",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "admin": "electron admin-main.js",
    "build": "electron-builder --win --x64",
    "build:installer": "electron-builder --win nsis --x64",
    "build:admin": "electron-builder --win --x64 --config electron-builder-admin.json",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.pokenight.launcher",
    "productName": "PokeNight",
    "win": {
      "target": "nsis",
      "icon": "assets/launcher-logo.ico",
      "executableName": "PokeNight",
      "sign": null,
      "signingHashAlgorithms": null
    },
    "compression": "store",
    "artifactName": "PokeNight-Setup-${version}.${ext}",
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "assets/launcher-logo.ico",
      "uninstallerIcon": "assets/launcher-logo.ico",
      "uninstallDisplayName": "PokeNight Launcher",
      "shortcutName": "PokeNight Launcher"
    },
    "files": [
      "main.js",
      "package.json",
      "src/**/*",
      "assets/launcher-logo.ico",
      "assets/launcher-logo.webp",
      "assets/launcher-wallpaper.png",
      "assets/Pallet-Town-Theme.ogg",
      "assets/fonts/**/*",
      "assets/emblems/**/*",
      "assets/comments.json",
      "assets/cliente/**/*",
      "!assets/cliente/.launcher-update-info.json",
      "!assets/cliente/.updater-version",
      "!assets/cliente/**/*.log",
      "!assets/cliente/**/*.tmp",
      "!node_modules/archiver/**",
      "!node_modules/archiver-utils/**",
      "!node_modules/zip-stream/**",
      "!node_modules/compress-commons/**",
      "!node_modules/basic-ftp/**",
      "!node_modules/fs-extra/**",
      "!node_modules/ssh2/**",
      "!node_modules/cpu-features/**",
      "!node_modules/nan/**",
      "!admin-main.js",
      "!admin.html",
      "!admin-settings.json",
      "!electron-builder-admin.json",
      "!server/**",
      "!dist/**"
    ],
    "extraResources": [],
    "asar": false
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "axios": "^1.13.5",
    "basic-ftp": "^5.1.0",
    "fs-extra": "^11.3.3",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  }
}
